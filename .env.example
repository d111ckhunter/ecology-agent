# 复制为 .env 并按本机实际情况修改；.env 不入库
# 本文件是模板，请勿填写真实密码/密钥。

# ---- 主连接（建库/建表/mock 灌数用，需要写权限）----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_admin_password
DB_NAME=ecology_demo

# ---- 只读连接（Agent 查询用；可先运行 scripts/setup_readonly_user.py 自动创建并回填）----
DB_RO_HOST=127.0.0.1
DB_RO_PORT=3307
DB_RO_USER=ecology_ro
DB_RO_PASSWORD=your_readonly_password
DB_RO_NAME=ecology_demo

# ---- LLM（DeepSeek，OpenAI 兼容接口）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
